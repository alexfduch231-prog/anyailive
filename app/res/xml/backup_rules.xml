<?xml version="1.0" encoding="utf-8"?>
<!-- API 24-30 (android:fullBackupContent).
     Резервное копирование приватных данных выключено целиком: переписка (database),
     ключи API в SharedPreferences "secrets", записи реплик (files) и внешние файлы
     не попадают ни в облачный бэкап, ни в перенос на другое устройство. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
