<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ (android:dataExtractionRules).
     Облачный бэкап и перенос на новое устройство отключаются отдельно:
     android:allowBackup="false" сам по себе не останавливает device-to-device
     transfer. Исключаются те же приватные домены, что и в backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
