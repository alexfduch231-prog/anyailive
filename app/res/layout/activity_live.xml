<?xml version="1.0" encoding="utf-8"?>
<!-- Живой режим в духе Gemini Live: чёрный экран, крупный заголовок и
     живая волна по центру, субтитры и управление — пилюлями внизу.
     Все прежние id сохранены: код LiveActivity не меняет привязок. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/live_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#040812">

    <ru.alexv.anyailive.ui.LiveGlowView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Центр: заголовок + волна + состояние -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:id="@+id/live_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="30sp"
            android:textColor="#FFF3F6FF"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/live_title" />

        <!-- Субтитры к реплике модели — над волной, чтобы читать со слуха непонятное -->
        <TextView
            android:id="@+id/live_ai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textSize="16sp"
            android:textColor="#FFF3F6FF"
            android:maxLines="3"
            android:ellipsize="start" />

        <ru.alexv.anyailive.ui.WaveformView
            android:id="@+id/live_wave"
            android:layout_width="220dp"
            android:layout_height="72dp"
            android:layout_marginTop="36dp" />

        <!-- Старый пульсирующий круг больше не нужен, но id оставлен для кода -->
        <View
            android:id="@+id/live_circle"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/live_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textSize="14sp"
            android:textColor="#FFBBC9DE"
            android:text="@string/live_connecting" />
    </LinearLayout>

    <!-- Низ: субтитры + ввод -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/live_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#FFBBC9DE"
            android:maxLines="2"
            android:ellipsize="start"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/live_input"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:hint="@string/live_input_hint"
                android:textColorHint="?attr/colMuted"
                android:textColor="?attr/colFg"
                android:textSize="15sp"
                android:inputType="textCapSentences"
                android:maxLines="2" />

            <Button
                android:id="@+id/btn_live_send"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:background="@drawable/bg_pill_button"
                android:text="@string/btn_send" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_live_interrupt"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_pill_button"
                android:text="@string/live_interrupt" />

            <Button
                android:id="@+id/btn_live_hangup"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_pill_button"
                android:text="@string/live_hangup" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
