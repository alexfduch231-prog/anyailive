<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/edit_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/edit_title_new"
            android:textColor="@color/fg"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/field_name"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/f_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/field_name"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/fg"
            android:textColorHint="@color/muted"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/field_base_url"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/f_base_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_base_url"
            android:inputType="textUri"
            android:maxLines="1"
            android:textColor="@color/fg"
            android:textColorHint="@color/muted"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/field_model_id"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/f_model_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_model_id"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/fg"
            android:textColorHint="@color/muted"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/field_api_key"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/f_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_api_key"
            android:inputType="textPassword"
            android:maxLines="1"
            android:textColor="@color/fg"
            android:textColorHint="@color/muted"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/field_live_protocol"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/f_live_protocol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/field_live_url"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/f_live_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_optional"
            android:inputType="textUri"
            android:maxLines="1"
            android:textColor="@color/fg"
            android:textColorHint="@color/muted"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/field_live_model"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/f_live_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_optional"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/fg"
            android:textColorHint="@color/muted"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/field_voice"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/f_voice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_voice"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/fg"
            android:textColorHint="@color/muted"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btn_save" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_check_chat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/check_chat"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_check_realtime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/check_realtime"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
