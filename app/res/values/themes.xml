<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Базовая тема: значения по умолчанию (тёмная палитра Gemini).
         Каждая тема из ui/Themes переопределяет colX-атрибуты. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="colBg">@color/bg</item>
        <item name="colSurface">@color/surface</item>
        <item name="colSurface2">@color/surface2</item>
        <item name="colFg">@color/fg</item>
        <item name="colMuted">@color/muted</item>
        <item name="colAccent">@color/accent</item>
        <item name="colOnAccent">@color/onAccent</item>
        <item name="colLine">@color/line</item>
        <item name="colBubbleUser">@color/bubbleUser</item>
        <item name="colBubbleAi">@color/bubbleAi</item>
        <item name="android:windowBackground">?attr/colBg</item>
        <item name="android:statusBarColor">?attr/colBg</item>
        <item name="android:navigationBarColor">?attr/colBg</item>
        <item name="android:textColorPrimary">?attr/colFg</item>
        <item name="android:colorAccent">?attr/colAccent</item>
        <!-- Все кнопки приложения — пилюли в духе Gemini -->
        <item name="android:buttonStyle">@style/PillButton</item>
    </style>

    <style name="ThemeDark" parent="AppTheme" />

